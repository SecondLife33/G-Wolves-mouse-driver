{
  "name": "driver",
  "version": "1.0.0",
  "description": "uwu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "secondlife",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.secondlife.mousedriver",
    "productName": "Mouse Driver",
    "compression": "normal",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "main.js",
      "htxu/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe",
      "requestExecutionLevel": "user"
    },
    "directories": {
      "output": "dist"
    }
  }
}